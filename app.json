{
  "expo": {
    "name": "Vibe Cooking",
    "slug": "vibe-cooking-expo",
    "scheme": "vibecooking",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFF7F2"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sanami.vibecooking",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "音声で調理ナビゲーションを操作するためにマイクを使用します。",
        "NSSpeechRecognitionUsageDescription": "音声で調理手順を進めるために音声認識を使用します。"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "音声で調理ナビゲーションを操作するためにマイクを使用します。",
          "speechRecognitionPermission": "音声で調理手順を進めるために音声認識を使用します。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
