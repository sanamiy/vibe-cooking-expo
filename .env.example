# Expo local development (direct_client mode)
# Copy this file to .env and fill in values

# VPS proxy URL (vps_proxy mode only)
EXPO_PUBLIC_VPS_API_BASE_URL=https://temp.synome.jp

# API keys (direct_client mode only)
EXPO_PUBLIC_MISTRAL_API_KEY=
EXPO_PUBLIC_CLAUDE_API_KEY=
EXPO_PUBLIC_ELEVENLABS_API_KEY=
EXPO_PUBLIC_ELEVENLABS_VOICE_ID=
EXPO_PUBLIC_ELEVENLABS_MODEL=

# BGM link (optional)
EXPO_PUBLIC_MUSIC_LINK=
