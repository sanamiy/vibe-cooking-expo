{
  "name": "vibe-cooking-expo",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "node scripts/start-dev.js",
    "start": "node scripts/start-expo-auto-port.js",
    "ios": "node scripts/start-expo-auto-port.js -- --ios",
    "android": "node scripts/start-expo-auto-port.js -- --android",
    "web": "node scripts/start-expo-auto-port.js -- --web",
    "deploy:vps": "node scripts/deploy-vps.js",
    "api:vps": "node scripts/set-api-mode.js vps_proxy",
    "api:direct": "node scripts/set-api-mode.js direct_client",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:web": "npx expo export --platform web",
    "e2e:server": "CI=1 npx expo start --web --port 19006",
    "e2e:offline": "node scripts/set-tts-config.js offline_expospeech && CI=1 playwright test",
    "e2e:online": "node scripts/set-tts-config.js online_elevenlabs && CI=1 playwright test",
    "e2e:both": "npm run e2e:offline && npm run e2e:online",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "test:voxtral-speech": "node scripts/test-voxtral-speech-understanding.js",
    "scrape:recipes": "python3 scripts/scraping-ajinomoto.py",
    "validate:recipes": "python3 scripts/validate_recipe_json.py"
  },
  "dependencies": {
    "@expo-google-fonts/m-plus-rounded-1c": "0.4.3",
    "@expo-google-fonts/quicksand": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@ricky0123/vad-web": "^0.0.30",
    "expo": "^54.0.33",
    "expo-av": "^16.0.8",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@cloudflare/workers-types": "^4.20260301.1",
    "@playwright/test": "^1.46.0",
    "@types/react": "~19.1.10",
    "prettier": "^3.3.3",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": "22.12.0"
  }
}
